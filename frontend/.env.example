# Frontend Web Dashboard Configuration (Avalanche Security Triage)
# Copy to .env.local for local development. Never commit .env.local with real secrets.

# Backend Triage API Base URL
NEXT_PUBLIC_API_URL=http://localhost:3001

# AvaTriageRegistry Contract Address on Avalanche Fuji (Pending deployment)
# Leave empty or set to verified Fuji address. Attestation is disabled if empty/unconfigured.
NEXT_PUBLIC_REGISTRY_ADDRESS=

# WalletConnect / Reown Project ID (Public client identifier for Web3 modal)
NEXT_PUBLIC_WC_PROJECT_ID=placeholder_wc_project_id
