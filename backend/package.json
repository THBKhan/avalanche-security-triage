{
  "name": "avalanche-security-triage-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Backend engine for Avalanche Security Triage: RPC context reader, static analysis, and AI triage",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && node scripts/copy-schemas.js",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/**/*.test.ts",
    "test:rpc": "tsx src/scripts/test-rpc.ts",
    "smoke:gemini": "tsx src/scripts/smoke-gemini.ts",
    "verify:report": "tsx src/scripts/verify-report.ts"
  },
  "dependencies": {
    "@solidity-parser/parser": "^0.20.2",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "viem": "^2.23.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.4",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
