# Backend Service Configuration (Avalanche Security Triage)
# Copy to .env and configure for local development. Never commit .env with real secrets.

# HTTP Server Port
PORT=3001

# Avalanche Fuji Testnet RPC Endpoint (Chain ID: 43113)
FUJI_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc

# LLM Configuration (Optional for health/RPC inspection; required when enabling live AI triage)
# Supported provider: gemini
# Model ID must be declared explicitly (no hardcoded default model)
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=

# Optional verified AvaTriageRegistry address on Fuji.
REGISTRY_ADDRESS=

# Optional persistent path. Defaults to backend/.report-snapshots.
REPORT_SNAPSHOT_DIR=

# Allowed CORS Origin for Web Dashboard
CORS_ORIGIN=http://localhost:3000
